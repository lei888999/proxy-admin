# Copy to .deploy.env (gitignored) for the rsync/ssh deploy loop.

# SSH target for the VPS (user@host). Key-based auth is assumed.
DEPLOY_HOST=root@your.vps.ip

# Directory on the VPS where the repo is synced (created on first deploy).
DEPLOY_PATH=/opt/sing-box-admin

# SSH port (optional, defaults to 22).
# DEPLOY_PORT=22
