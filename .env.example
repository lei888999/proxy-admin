# Copy to .env and fill in before running `docker compose up`.

# Secret used to sign JWT session cookies (REQUIRED).
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Port the admin panel listens on. With host networking this binds directly on
# the VPS, so open it in your security group. Proxy ports are bound the same way
# and only need to be allowed in the security group — no compose changes needed.
# PORT=8080

# Initial admin account, seeded only on first run (optional overrides).
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=mnice7082

# Public host (domain or IP) clients use to reach the proxy. Used as the
# `server` field in generated Clash subscriptions. No port — the proxy port
# comes from each inbound. Falls back to the request host if unset.
# SERVER_HOST=your.domain.com

# Optionally pin the sing-box version baked into the image.
# SING_BOX_IMAGE=ghcr.io/sagernet/sing-box:v1.11.4
